{
  "description": "Refuses destructive git commands and skipped checks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/skills/harness-setup/scripts/guardrails.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
